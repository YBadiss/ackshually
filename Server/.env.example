# Copy to .env for local runs. In production these live in /home/deploy/secrets/ackshually-server.env.

ANTHROPIC_API_KEY=
# Comma-separated <client-name>:<sha256 of token>. Create entries with: npm run token -- <client-name>
APP_TOKENS=

# PORT=3002
# HOST=127.0.0.1
# DATA_FOLDER=./data                         # holds ackshually.db (request log + daily spend)
# ALLOWED_MODELS=claude-sonnet-5-5,claude-opus-5-5
# MAX_TOKENS=16000
# MAX_BODY_MB=32
# DAILY_LIMIT_USD_PER_CLIENT=5
# DAILY_LIMIT_USD_TOTAL=20
# REQUESTS_PER_MINUTE=10
# ANTHROPIC_VERSION=2026-10-21
# ANTHROPIC_BASE_URL=https://api.anthropic.com
