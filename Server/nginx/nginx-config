# ackshually.badyass.xyz → the ackshually server (PM2, port 3002). Only the two routes the app uses are exposed.
limit_req_zone $binary_remote_addr zone=ackshually_api:1m rate=2r/s;

server {
    server_name ackshually.badyass.xyz;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /v1/messages {
        limit_except POST { deny all; }
        limit_req zone=ackshually_api burst=10 nodelay;

        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Answers stream as server-sent events: pass tokens through as they arrive.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;

        # The rulebook PDF travels base64-encoded in each request (Anthropic's limit is 32 MB).
        client_max_body_size 32M;
        client_body_buffer_size 1M;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3002;
    }

    location / {
        return 404;
    }

    access_log /var/log/nginx/ackshually.access.log;
    error_log /var/log/nginx/ackshually.error.log;

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/ackshually.badyass.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ackshually.badyass.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name ackshually.badyass.xyz;
    return 301 https://$host$request_uri;
}
