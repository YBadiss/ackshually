// Copy to Secrets.xcconfig (git-ignored) and paste the app token from `npm run token -- <name>` (Server/).
// The token is bundled into the app's Info.plist: anyone with the binary can read it, so only use builds
// with a real token on our own devices and TestFlight (see Server/README.md).
ACKSHUALLY_APP_TOKEN =

// Signing for device and Mac builds: your team ID (Xcode → Settings → Accounts). A free Personal Team works.
DEVELOPMENT_TEAM =
